<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://www.googletagmanager.com https://googleads.g.doubleclick.net; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://pontoagil.playercontabilidade.com https://www.google-analytics.com https://www.google.com https://ad.doubleclick.net; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta name="referrer" content="strict-origin-when-cross-origin">

  <meta name="description" content="<%= typeof descricao !== 'undefined' && descricao ? descricao : 'Sistema de ponto eletrônico com reconhecimento facial, conformidade com a Portaria 671 e indicadores de RH em um só lugar.' %>">
  <link rel="canonical" href="https://portal.pontoagil.com.br<%= typeof caminhoCanonico !== 'undefined' ? caminhoCanonico : '/' %>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ponto Ágil">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:title" content="<%= titulo %>">
  <meta property="og:description" content="<%= typeof descricao !== 'undefined' && descricao ? descricao : 'Sistema de ponto eletrônico com reconhecimento facial, conformidade com a Portaria 671 e indicadores de RH em um só lugar.' %>">
  <meta property="og:url" content="https://portal.pontoagil.com.br<%= typeof caminhoCanonico !== 'undefined' ? caminhoCanonico : '/' %>">
  <meta property="og:image" content="https://portal.pontoagil.com.br/images/mock.png">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= titulo %>">
  <meta name="twitter:image" content="https://portal.pontoagil.com.br/images/mock.png">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18361312845"></script>
  <script src="/js/analytics.js" defer></script>
  <title><%= titulo %></title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof estiloPagina !== 'undefined' && estiloPagina) { %>
    <link rel="stylesheet" href="/css/pages/<%= estiloPagina %>.css">
  <% } %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>
  <%- include('../partials/header', { pagina }) %>
  <%- include('../' + conteudoParcial) %>
  <%- include('../partials/footer', { pagina }) %>

  <% if (exibirWhatsapp) { %>
    <a href="https://wa.me/5563993124723" class="whatsapp-float" target="_blank" rel="noopener noreferrer"
      aria-label="Fale conosco no WhatsApp">
      <span class="whatsapp-tooltip">Oi, posso te ajudar?</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
    </a>
  <% } %>

  <%
    const dadosPagina = {
      apiBaseUrl: typeof apiBaseUrl !== 'undefined' && apiBaseUrl ? apiBaseUrl : '',
    };
    if (typeof planos !== 'undefined' && Array.isArray(planos) && planos.length) {
      dadosPagina.planos = planos;
    }
    if (typeof parceiro !== 'undefined' && parceiro) {
      dadosPagina.parceiro = parceiro;
    }
  %>
  <script type="application/json" id="dados-pagina"><%- JSON.stringify(dadosPagina).replace(/</g, '\\u003c') %></script>
  <script type="module" src="/js/app.js"></script>
</body>

</html>
